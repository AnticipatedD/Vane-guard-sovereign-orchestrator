# Application Runtime & CI Environment
NODE_ENV=development
CI=false
LOG_FORMAT=json

# Algolia Configuration
ALGOLIA_API_KEY=your_algolia_key_here

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_BASE_URL=https://api.cloudflare.com/client/v4

# Cloudflare Access (used by internal tooling / scripts)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Client & Identity Configuration
CLIENT_ID=vane_guard_dev_client
USER_ID=vane_guard_dev_user

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=AnticipatedD
GITHUB_REPO=Vane-guard-sovereign-orchestrator

# Jira Integration
JIRA_AUTH_TOKEN=your_jira_token_here
JIRA_HOSTNAME=

# Branch / Deployment
BRANCH_SLUG=main

# Debug / Tooling & Reporting
NODE_DEBUG=
REPORT_PATH=./reports
RUN_LINK_CHECK=false
VERBOSE=false
